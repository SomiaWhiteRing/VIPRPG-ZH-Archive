{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "viprpg-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "status.viprpg.org", "custom_domain": true }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "STATUS_DB",
      "database_name": "viprpg-status",
      "database_id": "STATUS_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
