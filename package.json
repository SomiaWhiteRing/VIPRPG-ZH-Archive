    "test:flow": "npm run build && tsx scripts/system-self-check.ts flow",
    "regression": "node scripts/regression.mjs",
    "verify:preprod": "npm run check && npm run test:flow",
    "auth:calibrate-password": "tsx scripts/password-calibration.ts",
