<resources>
    <style name="ScreenshotViewerTheme" parent="GalleryTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="AppTheme" parent="GalleryTheme">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/native_accent</item>
        <item name="android:statusBarColor">@color/native_surface</item>
        <item name="android:navigationBarColor">@color/native_surface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
    </style>
    <!-- Shared native-page theme; gallery controls define the application palette. -->
    <style name="GalleryTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/native_primary</item>
        <item name="colorOnPrimary">@color/native_on_primary</item>
        <item name="colorPrimaryContainer">@color/native_tint</item>
        <item name="colorOnPrimaryContainer">@color/native_on_tint</item>
        <item name="colorSecondary">@color/native_accent</item>
        <item name="colorSurface">@color/native_background</item>
        <item name="colorSurfaceContainerHigh">@color/native_surface</item>
        <item name="colorSurfaceContainer">@color/native_background</item>
        <item name="colorSurfaceContainerLow">@color/native_background</item>
        <item name="colorSurfaceVariant">@color/native_variant</item>
        <item name="colorControlActivated">@color/native_primary</item>
        <item name="colorOnSurface">@color/native_ink</item>
        <item name="colorOnSurfaceVariant">@color/native_muted</item>
        <item name="colorOutline">@color/native_border</item>
        <item name="android:windowBackground">@color/native_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/native_accent</item>
    </style>
    <style name="NativeTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/native_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <!-- The download is the page's primary action; retain Material's state colors. -->
    <style name="NativePrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
