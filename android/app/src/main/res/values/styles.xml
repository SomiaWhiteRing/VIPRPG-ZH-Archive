<resources>
    <style name="AppTheme" parent="GalleryTheme">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2F9F92</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- Shared native-page theme; gallery controls define the application palette. -->
    <style name="GalleryTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#1F6F67</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E0F0EB</item>
        <item name="colorOnPrimaryContainer">#185B54</item>
        <item name="colorSecondary">#2F9F92</item>
        <item name="colorSurface">#F5F4EF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorSurfaceContainer">#F5F4EF</item>
        <item name="colorSurfaceContainerLow">#F5F4EF</item>
        <item name="colorSurfaceVariant">#E7ECE7</item>
        <item name="colorControlActivated">#1F6F67</item>
        <item name="colorOnSurface">#17212B</item>
        <item name="colorOnSurfaceVariant">#68737D</item>
        <item name="colorOutline">#D9DDD9</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2F9F92</item>
    </style>
    <style name="NativeTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#1F6F67</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <!-- The download is the page's primary action; retain Material's state colors. -->
    <style name="NativePrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
