<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="gone" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/online_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <WebView
                    android:id="@+id/browser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <WebView
                android:id="@+id/offline_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
            <FrameLayout
                android:id="@+id/library_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/version_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@color/native_background">
                <FrameLayout
                    android:id="@+id/version_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <ScrollView
                    android:id="@+id/version_panel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:id="@+id/version_app_name"
                        android:text="@string/app_name"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/native_ink" />
                    <TextView
                        android:id="@+id/installed_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/native_muted" />
                    <View
                        android:id="@+id/version_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/native_border" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:id="@+id/update_heading"
                        android:text="@string/update_heading"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/native_ink" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/update_status_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_version"
                            app:tint="@color/native_primary" />
                        <TextView
                            android:id="@+id/update_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/not_checked"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/native_ink" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/update_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/not_checked_detail"
                        android:textSize="14sp"
                        android:textColor="@color/native_muted" />
                    <TextView
                        android:id="@+id/release_notes_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/release_notes_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/native_ink"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/release_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:textSize="14sp"
                        android:textColor="@color/native_muted"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        style="@style/NativePrimaryButton"
                        android:id="@+id/download_update"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/download_update"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        style="@style/NativeTextButton"
                        android:id="@+id/check_update"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/check_update"
                        android:textAllCaps="false" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/auto_check_updates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/auto_check_updates"
                        android:textColor="@color/native_muted" />
                </LinearLayout>
                </ScrollView>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/gallery_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/native_surface"
            android:elevation="8dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/online_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/online_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_online" />
                <TextView android:id="@+id/online_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/online" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/library_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/library_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_library" />
                <TextView android:id="@+id/library_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/local_games" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/gallery_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/gallery_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_gallery" />
                <TextView android:id="@+id/gallery_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/screenshot_gallery" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/version_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/version_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_version" />
                <TextView android:id="@+id/version_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/native_version" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
