<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:visibility="gone" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <WebView
                android:id="@+id/browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ScrollView
                android:id="@+id/version_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone"
                android:background="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/native_version"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#182326" />
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="36dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_app" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/app_name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#182326" />
                    <TextView
                        android:id="@+id/installed_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="#58686A" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="40dp"
                        android:background="#DCE4E2" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:text="@string/update_heading"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#182326" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_version"
                            android:tint="#1F6F67" />
                        <TextView
                            android:id="@+id/update_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/not_checked"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#182326" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/update_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/not_checked_detail"
                        android:textSize="14sp"
                        android:textColor="#58686A" />
                    <TextView
                        android:id="@+id/release_notes_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/release_notes_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#182326"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/release_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:textSize="14sp"
                        android:textColor="#58686A"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/download_update"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="28dp"
                        android:backgroundTint="#1F6F67"
                        android:text="@string/download_update"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/check_update"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#1F6F67"
                        android:text="@string/check_update"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/online_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/online_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_online" />
                <TextView android:id="@+id/online_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/online" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/library_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/library_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_library" />
                <TextView android:id="@+id/library_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/local_games" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/version_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView android:id="@+id/version_icon" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_version" />
                <TextView android:id="@+id/version_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/native_version" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
